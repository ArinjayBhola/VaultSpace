# Copy to .env.local. Never commit credentials. Use pooled Neon URL for runtime.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Provisioning command only; no default password. Remove password after provisioning.
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_NAME=Owner
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional endpoint override; otherwise derived from account ID.
R2_ENDPOINT=
MAX_UPLOAD_BYTES=1073741824
MAX_PROCESSING_BYTES=52428800
